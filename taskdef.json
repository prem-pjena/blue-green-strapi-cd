{
  "family": "strapi-task-family",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::331405041655:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::331405041655:role/strapi-task-role",
  "containerDefinitions": [
    {
      "name": "strapi",
      "image": "ECR_IMAGE_URI_PLACEHOLDER",  
      "essential": true,
      "portMappings": [
        {
          "containerPort": 1337,
          "hostPort": 1337,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "JWT_SECRET",
          "value": "JWT_SECRET_VALUE_PLACEHOLDER"  
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/strapi",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
