{
  "family": "strapi-task-family",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::331405041655:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::331405041655:role/strapi-task-role",
  "containerDefinitions": [
    {
      "name": "strapi",
      "image": "331405041655.dkr.ecr.us-east-1.amazonaws.com/strapi-app:latest", 
      "essential": true,
      "portMappings": [
        {
          "containerPort": 1337,
          "hostPort": 1337,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
